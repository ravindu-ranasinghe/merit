# Required
DATABASE_URL=postgres://merit:merit@localhost:5433/merit

# Optional, defaults shown
PORT=4000
WEB_ORIGIN=http://localhost:3000
CHAIN_ID=5042002
EXPLORER_URL=https://explorer.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Escrow contract address (from Engineer A's deploy). Unset = zero address, warned at boot.
ESCROW_ADDRESS=

# Random 32+ chars. Signs the session cookie and wallet challenges. Required when NODE_ENV=production.
SESSION_SECRET=

# QuickNode Streams security token (Stream settings tab). Required when NODE_ENV=production.
QN_SECURITY_TOKEN=

# GitHub App. If ANY of these is missing the api runs against the in-memory MOCK GitHub client.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Post and update one Merit status comment on each funded PR from indexed escrow events.
# Needs the GitHub App permission "Issues: Read and write" (or "Pull requests: Read and write"). "0" turns it off.
GITHUB_PR_COMMENTS=1

# Bearer token for POST /internal/sweep, called by a scheduler. 16+ random characters. Unset = route disabled (404).
SWEEP_SECRET=

# Canonical validation only; Streams remains the event source. Optional, defaults to public Arc testnet RPC.
CANONICAL_RPC_URL=https://rpc.testnet.arc.io
