# Copy to .env.local. Every value here is public and reaches the browser; the web app holds no secrets.

# 1 = mock mode: fixtures only. No backend, no Arc RPC, no GitHub, no secrets needed.
NEXT_PUBLIC_MOCK=1

# --- Public, browser-visible config (live mode). Set NEXT_PUBLIC_MOCK=0 to use it. ---
# Engineer B's API (docs/api.md). Its CORS allows http://localhost:3000 with credentials;
# sign-in is the backend's own GitHub OAuth and httpOnly session cookie.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# For hosted live mode, set NEXT_PUBLIC_BACKEND_URL=/api/merit and
# MERIT_API_ORIGIN=https://your-backend.vercel.app (server-side rewrite target).
# BountyEscrow on Arc testnet. Defaults to the deployed address in docs/escrow-interface.md.
# NEXT_PUBLIC_ESCROW_ADDRESS=0x924525bF3f3A39f9c7f298E71aFf43F4c27a4727
# GitHub App slug, for the "Connect a repository" install link.
NEXT_PUBLIC_GITHUB_APP_SLUG=
# 1 = offer a 45-minute deadline when creating a bounty, to demo expiry and refund on testnet.
# Always on in mock mode. Leave unset for normal use.
# NEXT_PUBLIC_DEMO_DEADLINES=1
# Optional overrides. Defaults are the frozen SPEC.md values.
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
