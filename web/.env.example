# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser; never put a secret in one.

# 1 = mock mode: fixtures only. No backend, no Arc RPC, no GitHub, no secrets needed.
NEXT_PUBLIC_MOCK=1

# --- Public, browser-visible config (live mode) ---
# BountyEscrow address on Arc testnet, from docs/escrow-interface.md once deployed.
NEXT_PUBLIC_ESCROW_ADDRESS=
# GitHub App slug, for the "Connect a repository" install link.
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Optional overrides. Defaults are the frozen SPEC.md values.
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# --- Server-side only (live mode). Never prefix these with NEXT_PUBLIC_. ---
# Engineer B's API base URL. The browser reaches it only through /api/backend.
BACKEND_URL=
# GitHub OAuth app, for sign-in.
GITHUB_ID=
GITHUB_SECRET=
# NextAuth session encryption. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
